# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hi Clinic

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yevufyljrzakmzgoouph.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Observability (Raio-X EN5). Erros do servidor, falhas do cron de envio e
# do webhook do WhatsApp avisam por qualquer um dos dois (ou pelos dois), sem
# dado pessoal e no máximo uma vez a cada 5 minutos por tipo de erro:
# - SENTRY_DSN: DSN de um projeto no Sentry (não precisa do SDK);
# - ALERT_WEBHOOK_URL: webhook de entrada do Slack, Google Chat ou Discord.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
ALERT_WEBHOOK_URL=
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=/api/observability/client-error

# WhatsApp — Evolution API (módulo de Atendimento)
# Preencha em apps/web/.env.local (NUNCA commite os valores reais).
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo compartilhado que a Evolution envia no header do webhook (você define).
WHATSAPP_WEBHOOK_SECRET=
# Chave mestra do servidor usada para criptografar credenciais por clínica.
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=

# IA de atendimento (rascunho de resposta com Claude)
ANTHROPIC_API_KEY=

# Worker de notificações e manutenção (POST /api/jobs/dispatch)
# Sem este segredo a rota fica desligada e nada é enviado. Configure um cron
# externo batendo a cada 2-5 minutos com o header:
#   authorization: Bearer <valor>
JOBS_WORKER_SECRET=

# Captcha do agendamento online (Cloudflare Turnstile). Opcional: sem as
# duas chaves o agendamento segue sem captcha, só com os limites do banco.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bloqueio de tela por inatividade, em minutos (0 desliga). Padrão: 15.
NEXT_PUBLIC_IDLE_LOCK_MINUTES=15

# Segredo dos links de documento enviados ao paciente (recomendado). Sem ele
# o app deriva um segredo da service role.
DOCUMENT_LINK_SECRET=
